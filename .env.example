# Flask Application
SECRET_KEY=your-secret-key
FLASK_DEBUG=True
PORT=5000
PUBLIC_API_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Railway web process reliability
MEDIMENTORA_WEB_WORKERS=1
MEDIMENTORA_WEB_THREADS=2
RUN_SCHEMA_BOOTSTRAP=true
SCHEMA_BOOTSTRAP_RETRY_SECONDS=10
DB_BOOTSTRAP_ATTEMPTS=30
DB_BOOTSTRAP_RETRY_SECONDS=2
# Keep false on the web service. Create a separate Railway service with the
# start command `python -m app.learning_worker` for background document jobs.
RUN_LEARNING_WORKER=false

# MySQL Database (the only database connection variable)
MYSQL_URL=mysql://root:your_password@localhost:3306/clinical_platform_db
# Railway:
# MYSQL_URL=${{MySQL.MYSQL_URL}}

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# OpenAI (AI Report Analysis & Simulation Feedback)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Gemini (AI Medical Teacher enrichment — optional)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
TEACHER_USE_AI=true

# AI Medical Teacher document processing
TEACHER_STORAGE_BACKEND=local
TEACHER_UPLOAD_FOLDER=uploads/medical_teacher/books
TEACHER_MAX_FILES=5
TEACHER_MAX_FILE_BYTES=104857600
TEACHER_MAX_TOTAL_BYTES=209715200
TEACHER_JOB_POLL_SECONDS=2
TEACHER_JOB_LEASE_SECONDS=1800
TEACHER_JOB_MAX_ATTEMPTS=3
TEACHER_LESSON_USE_AI=false
TEACHER_LESSON_MAX_SOURCE_CHARS=12000
TEACHER_EMBEDDING_PROVIDER=local_hash
TEACHER_EMBEDDING_MODEL=medimentora-hash-v1
TEACHER_EMBEDDING_DIMENSION=256
TEACHER_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TEACHER_CHUNK_SIZE_CHARS=1800
TEACHER_CHUNK_OVERLAP_CHARS=250
TEACHER_TUTOR_USE_AI=true
TEACHER_TUTOR_CONTEXT_CHUNKS=5
TEACHER_TUTOR_HISTORY_MESSAGES=8
TEACHER_TUTOR_MAX_MESSAGE_CHARS=2000
TEACHER_TUTOR_MAX_SESSION_MESSAGES=100
TEACHER_QUESTION_USE_AI=false
TEACHER_QUESTIONS_PER_TOPIC=5
TEACHER_QUESTION_MAX_SOURCE_CHARS=8000
TEACHER_DEFAULT_QUIZ_QUESTION_COUNT=10
TEACHER_QUIZ_MINUTES_PER_QUESTION=1.5
TEACHER_FLASHCARD_STYLES=easy,medium,hard,exam,nursing,clinical

# File Uploads
UPLOAD_FOLDER=uploads
UPLOAD_MAX_FILES=20
UPLOAD_MAX_TOTAL_BYTES=104857600
UPLOAD_MAX_FILE_BYTES=104857600
MAX_CONTENT_LENGTH=106954752

# X-Ray Analysis
XRAY_MAX_FILES=20
XRAY_MAX_FILE_BYTES=26214400
XRAY_MAX_TOTAL_BYTES=104857600
XRAY_MIN_WIDTH=64
XRAY_MIN_HEIGHT=64

# OCR engine: auto | paddleocr | tesseract | google_document_ai | azure_document_intelligence
# auto = cloud OCR if configured, else PaddleOCR (RapidOCR), else Tesseract
OCR_ENGINE=auto
OCR_PREPROCESS=true
OCR_TIMEOUT_SECONDS=120
TESSERACT_CMD=

# Optional Google Document AI
# GOOGLE_DOCUMENT_AI_PROJECT_ID=
# GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# GOOGLE_DOCUMENT_AI_LOCATION=us
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional Azure Document Intelligence
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Password Reset
RESET_TOKEN_EXPIRE_HOURS=24
FRONTEND_URL=http://localhost:3000

# Railway production examples (public values only):
# PUBLIC_API_URL=https://your-api.up.railway.app
# FRONTEND_URL=https://your-project.vercel.app
# CORS_ORIGINS=https://your-project.vercel.app
